{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(auth|subjects|tutor|profile|account|practice|progress|onboarding|subscribe|reset-password|admin)",
      "destination": "/_shell"
    },
    {
      "source": "/(subject|topic|lesson|paper)/:id",
      "destination": "/_shell"
    },
    {
      "source": "/admin/:path*",
      "destination": "/_shell"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(auth|subjects|tutor|profile|account|practice|progress|onboarding|subscribe|reset-password|admin|subject|topic|lesson|paper)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(admin|subject|topic|lesson|paper)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(_shell|404|pages)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
